APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Argentina/Buenos_Aires

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

DISCORD_WEBHOOK_URL=

SCALE_CONNECTION=main

# Caché donde el daemon `scale:watch` publica el peso. Conviene 'file' y no
# el caché de la aplicación: el vigilante escribe varias veces por segundo y
# no tiene sentido que eso vaya contra la tabla `cache` de MySQL.
SCALE_CACHE_STORE=file

# Vigilancia continua. Con el daemon corriendo, el navegador no abre ninguna
# conexión TCP a la balanza: lee lo que el vigilante dejó publicado.
SCALE_WATCH_INTERVAL_MS=200
SCALE_WATCH_READ_TIMEOUT_MS=800
SCALE_WATCH_CONNECT_TIMEOUT_MS=1000
SCALE_WATCH_STALE_AFTER_MS=2000
SCALE_WATCH_RETRY_BASE_MS=500
SCALE_WATCH_RETRY_MAX_MS=5000

# Muestras consecutivas dentro de la tolerancia (en divisiones de la balanza)
# para considerar el peso quieto y habilitar la captura.
SCALE_STABILITY_SAMPLES=4
SCALE_STABILITY_TOLERANCE_DIVISIONS=1

# Cada cuánto la pantalla de venta le pide el peso al servidor. No necesita
# coincidir con el intervalo del daemon: alcanza con que el número se vea fluido.
SCALE_POLL_MS=200

# Nombre con el que el operador conoce cada balanza en la pantalla de venta.
SCALE_LABEL="Mostrador 1"
SCALE_HOST=192.168.0.169
SCALE_PORT=8899
SCALE_TIMEOUT=3
SCALE_DIVISOR=1000
SCALE_UNIT=kg
SCALE_MIN_INTERVAL_MS=300

SCALE_2_LABEL="Mostrador 2"
SCALE_2_HOST=192.168.0.170
SCALE_2_PORT=8899
SCALE_2_TIMEOUT=3
SCALE_2_DIVISOR=1000
SCALE_2_UNIT=kg
SCALE_2_MIN_INTERVAL_MS=300
